# Sao chép thành `.env` rồi điền giá trị thật. KHÔNG commit `.env`.
# Mọi biến ở đây được đọc bởi `rag_core.settings.Settings`.

# ---------------------------------------------------------------- LLM API
# Provider chính cho serving và cho việc sinh nháp golden set.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Fallback + judge cross-check khác họ model.
# QUY TẮC CỨNG: cấm dùng `@preset/...` trong đường eval — preset là config phía
# server, có thể đổi ngầm làm metric dịch mà không truy được nguyên nhân.
# Luôn pin slug tường minh và log lại field `model` mà response trả về.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Chỉ cần khi tải model private hoặc đẩy corpus lên HF dataset repo cho job GPU thuê.
HF_TOKEN=

# ---------------------------------------------------------------- Hạ tầng
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_chunks

POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_local_dev_only
POSTGRES_DB=rag
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

REDIS_URL=redis://127.0.0.1:6379/0

# Hàng đợi arq cho job ingest (`W3-08`). Hai môi trường dùng chung một Redis mà
# để trùng tên thì worker của bên này nhặt job của bên kia, hỏng vì thiếu config,
# và job biến mất khỏi hàng đợi.
INGEST_QUEUE=arq:queue

# Thư mục DUY NHẤT mà `POST /ingest` được phép đọc config từ đó. Đây là cận trên
# của quyền đọc, không phải một tiện ích: request nhận một *tên*, ghép vào đây,
# rồi kiểm lại rằng đường dẫn kết quả không thoát ra ngoài.
INGEST_CONFIG_DIR=configs/indexing

# ---------------------------------------------------------------- Model
EMBEDDING_MODEL=bkai-foundation-models/vietnamese-bi-encoder
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=32

# ---------------------------------------------------------------- Khác
LOG_LEVEL=INFO
CACHE_DIR=.cache
