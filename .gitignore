# Dữ liệu sinh ra khi chạy
chroma_db/
.chroma/
.chunking_cache/
uploads/
*.pdf
# Trừ fixture của loader (`W3-01`): 2 KB, tự sinh bằng `make loader-fixtures`,
# và `tests/unit/test_loaders.py` đỏ nếu thiếu nó. Quy tắc `*.pdf` ở trên là để
# chặn tài liệu tải về, không phải để chặn fixture.
!tests/fixtures/loaders/*.pdf

# Cache & artifact của pipeline
.cache/
# Store MLflow. `mlruns/` là file store cũ (mlflow < 3); `mlflow.db` +
# `mlartifacts/` là backend hiện dùng. Không commit: nó là một *view* dựng lại
# được từ `plans/reports/runs/` bằng `make exp-backfill` — đó là toàn bộ điểm
# của `pipeline/experiments/backfill.py`.
mlruns/
mlflow.db
mlartifacts/
data/raw/
!data/**/.gitkeep

# `data/corpus/` KHÔNG liệt kê ở đây: DVC tự sinh `data/.gitignore` khi
# `dvc add`. Ignore ở hai chỗ thì `dvc checkout` vẫn chạy nhưng `dvc status`
# không còn phản ánh đúng thứ git thấy — nguồn sự thật phải là một.

# Artifact triage golden set. Sinh lại bằng `make goldenset-triage` trong ~25s,
# và chúng chỉ đúng với đúng một index (cùng `IndexConfig.fingerprint`), nên
# commit một bản cũ còn tệ hơn không commit. Giữ lại trong git:
#   · `decisions_*.csv`   — công review của người, không sinh lại được
#   · `triage_summary.json` — bằng chứng của lần chạy
data/golden/review/queue_*.md
data/golden/review/triage_*.jsonl
